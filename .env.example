# Aomi — environment variables (server-side only, JANGAN pakai prefix NEXT_PUBLIC_ untuk secret)

# Database utama: Upstash Redis (REST). Kosong → otomatis fallback ke GitHub repo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback storage + migrasi data: token dengan akses repo Rendyzzx/token
GITHUB_TOKEN=

# Secret enkripsi captcha & verifikasi token. Fallback: GITHUB_TOKEN.
SESSION_SECRET=

# Versi aplikasi (contoh: 2026.10.02.001). Naikkan untuk force-logout
# semua user versi lama. JANGAN fallback ke commit SHA.
APP_VERSION=
