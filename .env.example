# Aomi — environment variables (server-side only, JANGAN pakai prefix NEXT_PUBLIC_ untuk secret)

# Database utama: Upstash Redis (REST). Kosong → otomatis fallback ke GitHub repo.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Fallback storage + migrasi data: token dengan akses repo Rendyzzx/token
GITHUB_TOKEN=

# Secret enkripsi captcha & verifikasi token. Fallback: GITHUB_TOKEN.
SESSION_SECRET=

# Versi aplikasi (contoh: 2026.10.02.001). Naikkan untuk force-logout
# semua user versi lama. JANGAN fallback ke commit SHA.
APP_VERSION=

# Google OAuth — buat di https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: https://cyronime.web.id/api/auth/google/callback
# (untuk dev: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional — override redirect URI auto-detect (default: auto dari request)
# GOOGLE_REDIRECT_URI=https://cyronime.web.id/api/auth/google/callback

# Verifikasi Google Search Console — isi dengan nilai content dari
# <meta name="google-site-verification" content="..."> dari Search Console.
# Bila kosong, meta tag verifikasi tidak dirender (fitur lain tetap jalan).
GOOGLE_SITE_VERIFICATION=

# Fitur musik: override key dekripsi metadata savetube (hex 32 karakter).
# Opsional — key publik sudah built-in di lib/server/music.ts.
SAVETUBE_KEY=

# ---------- Telegram Admin Bot (opsional — bot admin Aomi) ----------
# Token bot dari @BotFather. Jika kosong, webhook Telegram menolak semua request.
TELEGRAM_BOT_TOKEN=
# Secret webhook — HARUS sama dengan yang dipakai saat setWebhook (set_secret_token).
# Contoh generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Numeric Telegram user id yang boleh pakai bot admin (bukan username!).
# Cek id kamu lewat @userinfobot. Format: "123456789" (owner) atau
# "123456789:owner,987654321:viewer" (role: owner/admin/operator/viewer).
TELEGRAM_ADMIN_IDS=
